# ===================================================================
# Grocery Choice Backend - Local Environment Configuration Template
# Copy this file to '.env' (in backend root) and enter your credentials.
# Note: '.env' is ignored by Git and will never be committed.
# ===================================================================

# Database Connection
DB_URL=jdbc:mysql://localhost:3306/grocery_choice?useSSL=false&serverTimezone=Asia/Kolkata&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_local_mysql_password

# MSG91 Server-Side Authentication Key (Server-to-Server only, never expose to frontend)
# MSG91_AUTH_KEY=your_msg91_account_authkey

# MSG91 Transactional SMS Configuration (separate from OTP widget)
# MSG91_SMS_URL=https://control.msg91.com/api/v5/flow/
# MSG91_SMS_SENDER_ID=GRCHCE
# MSG91_SMS_FLOW_ID=your_msg91_flow_or_template_id

# Razorpay Test Mode Credentials (Server-to-Server only, never expose secret to frontend)
# RAZORPAY_KEY_ID=your_razorpay_test_key_id
# RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret

# SMTP Email Configuration (Server-side only)
# SPRING_MAIL_HOST=smtp.your-provider.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=your_smtp_username
# SPRING_MAIL_PASSWORD=your_smtp_password
# MAIL_FROM=noreply@grocerychoice.com
# MAIL_SENDER_NAME=Grocery Choice
